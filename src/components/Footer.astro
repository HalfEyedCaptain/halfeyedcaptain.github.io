---
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import Topology from './Topology.astro';
import { getNavigation, getProfile, getSettings } from '@/lib/content';
import { url } from '@/lib/site';

const [nav, profile, settings] = await Promise.all([getNavigation(), getProfile(), getSettings()]);
const items = nav.items.filter((i) => i.footer);
const year = new Date().getFullYear();
const cmsUrl = settings.cms.showAdminLink ? url('/admin') : undefined;
---

<footer class="relative mt-32 overflow-hidden border-t border-ink-700 bg-ink-950">
  <Topology class="absolute -right-40 bottom-0 h-[130%] w-[70%] text-copper-500" opacity={0.1} cols={14} rows={9} />
  <div class="container-page relative grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div>
      <a href={url('/')} class="display text-3xl text-bone-50">{profile.name}</a>
      <p class="label mt-3">{profile.title}</p>
      <SocialLinks class="-ml-3 mt-6" />
    </div>

    <nav aria-label="Footer">
      <p class="label mb-4">Explore</p>
      <ul class="space-y-2">
        <li><a href={url('/')} class="text-bone-300 transition-colors hover:text-bone-50">Home</a></li>
        {
          items.map((i) => (
            <li>
              <a href={url(i.href)} class="text-bone-300 transition-colors hover:text-bone-50">
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="label mb-4">Résumé</p>
      <ul class="space-y-2">
        <li><a href={url('/resume')} class="text-bone-300 transition-colors hover:text-bone-50">View online</a></li>
        <li>
          <a href={url('/resume#print')} class="text-bone-300 transition-colors hover:text-bone-50">Print / save as PDF</a>
        </li>
      </ul>
      {settings.footerNote && <p class="mt-6 text-sm text-bone-500">{settings.footerNote}</p>}
    </div>
  </div>

  <div class="container-page relative flex flex-col gap-4 border-t border-ink-700 py-6 text-xs text-bone-500 md:flex-row md:items-center md:justify-between">
    <p>
      © {year} {profile.name}.{settings.rightsNotice && <> {settings.rightsNotice}</>}
    </p>
    {
      cmsUrl && (
        <a href={cmsUrl} class="inline-flex shrink-0 items-center gap-2 transition-colors hover:text-bone-100" rel="nofollow">
          <Icon name="edit" size={14} />
          Edit website
        </a>
      )
    }
  </div>
</footer>
