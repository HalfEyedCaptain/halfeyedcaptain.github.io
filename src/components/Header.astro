---
/** Site header with accessible desktop nav and a mobile disclosure menu. */
import Icon from './Icon.astro';
import { getNavigation, getProfile } from '@/lib/content';
import { url, withoutBase } from '@/lib/site';

interface Props {
  /** Transparent header that sits over full-bleed hero artwork. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const [nav, profile] = await Promise.all([getNavigation(), getProfile()]);
const items = nav.items.filter((i) => i.header);
const current = withoutBase(Astro.url.pathname).replace(/\/$/, '') || '/';

const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? current === '/' : current === h || current.startsWith(`${h}/`);
};
---

<header
  class:list={[
    'site-header fixed inset-x-0 top-0 z-40 transition-colors duration-300',
    overlay ? 'is-overlay' : 'is-solid',
  ]}
  data-header
>
  <div class="container-page flex h-(--header-h) items-center justify-between gap-6">
    <a href={url('/')} class="group flex items-baseline gap-3" aria-label={`${profile.name} — home`}>
      <span class="display text-xl leading-none text-bone-50 sm:text-[1.375rem]">{profile.name}</span>
      <span class="label hidden lg:inline">{profile.title}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          items.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class:list={[
                  'nav-link relative px-3 py-2 font-mono text-[0.75rem] tracking-[0.14em] uppercase transition-colors',
                  isActive(item.href) ? 'text-bone-50' : 'text-bone-300 hover:text-bone-50',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-bone-100 md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Open menu</span>
      <Icon name="menu" size={22} class="menu-open-icon" />
      <Icon name="close" size={22} class="menu-close-icon hidden" />
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Primary mobile" class="hidden border-t border-ink-700 bg-ink-950 md:hidden" data-mobile-nav>
    <ul class="container-page flex flex-col py-4">
      {
        items.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'display block py-3 text-3xl',
                isActive(item.href) ? 'text-copper-400' : 'text-bone-100',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header.is-solid,
  .site-header.is-scrolled,
  .site-header.menu-open {
    background: color-mix(in oklab, var(--color-ink-950) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-ink-700);
  }
  .site-header.is-overlay:not(.is-scrolled):not(.menu-open) {
    background: linear-gradient(to bottom, rgb(11 10 9 / 0.7), transparent);
    border-bottom: 1px solid transparent;
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 1px;
    background: var(--color-copper-500);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setOpen = (open: boolean) => {
    if (!toggle || !panel || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    toggle.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
    panel.classList.toggle('hidden', !open);
    header.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
