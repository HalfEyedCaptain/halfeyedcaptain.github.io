---
/** Shared page navigation and CMS profile-name home link. */
import { getProfile } from '@/lib/content';
import { url, withoutBase } from '@/lib/site';

const profile = await getProfile();
const current = withoutBase(Astro.url.pathname).replace(/\/$/, '') || '/';

const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? current === '/' : current === h || current.startsWith(`${h}/`);
};

---

<header class="reference-header">
  <div class="flex min-w-0 flex-wrap items-center gap-gutter-lg">
  <nav aria-label="Primary" class="reference-nav">
    {[
      { label: 'Home', href: '/' },
      { label: 'About Me', href: '/about' },
      { label: 'Resume', href: '/resume' },
      { label: 'Portfolio', href: '/work' },
    ].map((item) => (
      <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  </div>
    <a href={url('/')} class="reference-reel" aria-label={`${profile.name} — home`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 10 9-7 9 7v10H3Z" /><path d="M9 20v-7h6v7" /></svg>
      {profile.name}
    </a>
</header>
