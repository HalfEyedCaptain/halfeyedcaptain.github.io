---
/**
 * Landing intro (design: introduction_landing_page).
 * Left: archive rail of selected work + intro copy and skill chips.
 * Right: showcase of the top three projects, switchable via 01/02/03 pass buttons.
 * Without JS the first project shows and the pass buttons stay hidden.
 */
import ArtImage from './ArtImage.astro';
import Icon from './Icon.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import type { Project } from '@/lib/content';
import { formatYear } from '@/lib/dates';
import { url } from '@/lib/site';

interface Props {
  projects: Project[];
  image: { src: string; alt: string } | undefined;
  eyebrow?: string | undefined;
  heading: string;
  subheading?: string | undefined;
  intro?: string | undefined;
  chips?: string[];
  focus?: 'center' | 'top' | 'bottom' | 'left' | 'right';
  isPlaceholderImage?: boolean;
}

const { projects, image, eyebrow, heading, subheading, intro, chips = [], focus = 'center', isPlaceholderImage } = Astro.props;

const thumbOf = (p: Project) => p.data.thumbnail ?? p.data.hero ?? p.data.renders[0];
const heroOf = (p: Project) => p.data.hero ?? p.data.renders[0] ?? p.data.thumbnail;
const passes = projects.slice(0, 3);
const latestYear = passes.map((p) => formatYear(p.data.completed)).find(Boolean);
---

<section class="container-page reference-hero grid gap-gutter-lg lg:grid-cols-12" aria-labelledby="hero-title">
  <!-- Left: archive rail + intro -->
  <div class="flex min-w-0 flex-col justify-between gap-gutter-xl lg:col-span-5">
    {
      projects.length > 0 && (
        <div>
          <div class="mb-gutter-sm flex items-center justify-between gap-gutter-md">
            <p class="label">Other Works // Archive</p>
            <div class="flex gap-gutter-xs" data-rail-controls hidden>
              <button type="button" class="rail-btn" data-rail-dir="-1" aria-label="Scroll selected work left">
                <Icon name="chevron-left" size={16} />
              </button>
              <button type="button" class="rail-btn" data-rail-dir="1" aria-label="Scroll selected work right">
                <Icon name="chevron-right" size={16} />
              </button>
            </div>
          </div>
          <ul class="flex snap-x snap-mandatory gap-gutter-md overflow-x-auto pb-gutter-xs [scrollbar-width:none]" data-rail>
            {projects.map((p) => {
              const t = thumbOf(p);
              return (
                <li class="w-40 shrink-0 snap-start">
                  <a href={url(`/work/${p.slug}`)} class="group relative block overflow-hidden rounded-md border border-line">
                    <ArtImage
                      src={t?.src}
                      alt={t?.alt || p.data.title}
                      aspect="1 / 1"
                      widths={[240, 400]}
                      sizes="160px"
                      imgClass="transition-transform duration-500 ease-(--ease-enter) group-hover:scale-[1.04]"
                    />
                    <span class="absolute inset-x-gutter-sm bottom-gutter-sm truncate rounded-full bg-inverse/85 px-gutter-sm py-gutter-xs text-center font-mono text-label-md text-on-inverse uppercase">
                      {p.data.title}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    <div class:list={['flex flex-col gap-gutter-lg', projects.length > 0 && 'border-t border-line pt-gutter-md']}>
      <div class="flex flex-col gap-gutter-sm">
      <div class="flex flex-wrap items-center gap-gutter-sm">
        {eyebrow && <p class="font-mono text-label-md text-primary uppercase">{eyebrow}</p>}
        {subheading && <p class="font-mono text-label-md text-primary uppercase">// {subheading}</p>}
      </div>
      <h1 id="hero-title" class="display text-display-lg text-fg text-balance"><a href={url('/about')}>{heading}</a></h1>
      {intro && <p class="mt-gutter-xs max-w-prose text-body-md text-pretty text-fg-muted">{intro}</p>}
      </div>
      {
        chips.length > 0 && (
          <ul class="flex flex-wrap gap-gutter-sm" aria-label="Core skills">
            {chips.map((c) => (
              <li class="hero-skill">#{c.split(/\s+/).map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join('')}</li>
            ))}
          </ul>
        )
      }

    </div>
  </div>

  <!-- Right: showcase -->
  <div class="relative isolate min-h-[640px] overflow-hidden rounded-lg border border-fg bg-inverse lg:col-span-7" data-showcase>
    {
      passes.length > 0 ? (
        passes.map((p, i) => {
          const img = heroOf(p);
          const specs = [p.categoryInfo?.label, p.data.software.slice(0, 2).join(' // ')].filter(Boolean);
          return (
            <article class="absolute inset-0 flex flex-col justify-end" data-pass={i} hidden={i > 0} aria-labelledby={`pass-title-${i}`}>
              <div class="absolute inset-0 -z-10">
                <ArtImage
                  src={img?.src}
                  alt={img?.alt || p.data.title}
                  class="h-full w-full"
                  aspect="auto"
                  position="top"
                  widths={[768, 1200, 1600, 2000]}
                  sizes="(min-width: 1024px) 55vw, 100vw"
                  priority={i === 0}
                />
                <div class="absolute inset-0 bg-linear-to-t from-scrim/90 via-transparent to-scrim/20" aria-hidden="true" />
              </div>
              <div class="showcase-caption p-gutter-lg">
                {specs.length > 0 && (
                  <ul class="absolute right-6 top-1/2 flex -translate-y-1/2 flex-col items-end gap-gutter-md">
                    {specs.map((s, j) => (
                      <li class="inline-flex items-center gap-gutter-sm rounded-full border border-line bg-surface-lowest px-gutter-md py-gutter-sm font-mono text-label-md text-fg uppercase"><span class:list={['h-2 w-2 shrink-0 rounded-full', j === 0 ? 'bg-primary' : 'bg-fg']} aria-hidden="true" />{s}</li>
                    ))}
                  </ul>
                )}
                <div class="showcase-copy"><h2 id={`pass-title-${i}`} class="display text-headline-md text-on-scrim">{p.data.title}</h2>
                {p.data.summary && <p class="max-w-lg font-mono text-label-md text-on-scrim/85 uppercase">{p.data.summary}</p>}
                </div><div class="flex flex-wrap items-center gap-gutter-sm">
                  <a href={url(`/work/${p.slug}`)} class="btn btn-accent">
                    Inspect <Icon name="arrow-up-right" size={16} />
                  </a>
                  <PlaceholderBadge show={p.data.placeholder} />
                </div>
              </div>
            </article>
          );
        })
      ) : (
        <div class="absolute inset-0 flex flex-col justify-end">
          <div class="absolute inset-0 -z-10">
            <ArtImage src={image?.src} alt={image?.alt ?? ''} class="h-full w-full" aspect="auto" widths={[768, 1200, 1600, 2000]} sizes="(min-width: 1024px) 55vw, 100vw" position={focus} priority />
            <div class="absolute inset-0 bg-linear-to-t from-scrim/80 to-transparent" aria-hidden="true" />
          </div>
          <div class="p-gutter-xl">
            <PlaceholderBadge show={isPlaceholderImage} text="Placeholder artwork" />
          </div>
        </div>
      )
    }

    <div class="pointer-events-none absolute inset-x-0 top-0 flex flex-row-reverse items-start justify-between gap-gutter-md p-gutter-lg">
      <p class="rounded-full border border-surface-lowest bg-surface-lowest px-gutter-md py-gutter-xs font-mono text-label-md text-primary uppercase backdrop-blur">
        Latest work{latestYear ? ` // ${latestYear}` : ''}
      </p>
      {
        passes.length > 1 && (
          <div class="pointer-events-auto flex flex-col gap-gutter-xs" role="group" aria-label="Choose showcased project" data-pass-controls hidden>
            {passes.map((p, i) => (
              <button type="button" class="pass-btn" data-pass-btn={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Show ${p.data.title}`}>
                {String(i + 1).padStart(2, '0')}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-skill {
    border: 1px solid var(--color-fg);
    border-radius: 9999px;
    padding: 4px 16px;
    background: var(--color-surface-lowest);
    font: 500 12px/16px var(--font-mono);
    letter-spacing: .6px;
    text-transform: uppercase;
  }

  .rail-btn {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    background: var(--color-surface-lowest);
    color: var(--color-fg);
    transition: border-color 120ms var(--ease-standard), color 120ms var(--ease-standard);
  }
  .rail-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .pass-btn {
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.5rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: var(--text-label-md);
    color: var(--color-on-inverse);
    background: rgb(47 49 49 / .7);
    border: 1px solid rgb(255 255 255 / .6);
    transition: background-color 120ms var(--ease-standard), color 120ms var(--ease-standard);
  }
  .pass-btn:hover {
    color: var(--color-fg);
  }
  .pass-btn[aria-pressed='true'] {
    background: white;
    color: var(--color-fg);
  }
  [data-pass]:not([hidden]) {
    animation: pass-in 220ms var(--ease-enter);
  }
  @keyframes pass-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const railControls = document.querySelector<HTMLElement>('[data-rail-controls]');
  if (rail && railControls && rail.scrollWidth > rail.clientWidth) {
    railControls.hidden = false;
    railControls.querySelectorAll<HTMLButtonElement>('[data-rail-dir]').forEach((b) =>
      b.addEventListener('click', () => rail.scrollBy({ left: Number(b.dataset.railDir) * (rail.clientWidth * 0.8), behavior: 'smooth' })),
    );
  }

  const controls = document.querySelector<HTMLElement>('[data-pass-controls]');
  if (controls) {
    controls.hidden = false;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-pass-btn]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-pass]')];
    buttons.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
        panels.forEach((p, j) => (p.hidden = i !== j));
      }),
    );
  }
</script>
