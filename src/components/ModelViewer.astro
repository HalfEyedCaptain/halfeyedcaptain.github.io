---
/**
 * Optional interactive GLB / glTF viewer using Google <model-viewer>.
 * The (large) viewer library is only downloaded when the visitor clicks
 * "Load 3D model", keeping project pages light by default.
 */
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { resolveImage } from '@/lib/images';
import { url, isExternal } from '@/lib/site';

interface Props {
  src: string;
  alt: string;
  poster?: string | undefined;
  autoRotate?: boolean;
}
const { src, alt, poster, autoRotate = true } = Astro.props;

// Models live in /public/models (served as-is) or on an external host.
const modelUrl = isExternal(src) ? src : url(src.replace(/^\/?public\//, '/'));
let posterUrl: string | undefined;
const p = resolveImage(poster);
if (p?.kind === 'local') posterUrl = (await getImage({ src: p.meta, width: 1600, format: 'webp' })).src;
else if (p?.kind === 'remote') posterUrl = p.src;
---

<div class="model-shell relative aspect-[4/3] overflow-hidden bg-surface-container md:aspect-video" data-model-shell data-src={modelUrl} data-alt={alt} data-poster={posterUrl ?? ''} data-rotate={String(autoRotate)}>
  {posterUrl && <img src={posterUrl} alt="" class="absolute inset-0 h-full w-full object-contain opacity-60" loading="lazy" />}
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
    <Icon name="cube" size={40} class="text-primary" />
    <button type="button" class="btn btn-outline" data-model-load>Load interactive 3D model</button>
    <p class="label">Drag to orbit · Scroll to zoom</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-model-shell]').forEach((shell) => {
    const btn = shell.querySelector<HTMLButtonElement>('[data-model-load]');
    btn?.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Loading…';
      try {
        await import('@google/model-viewer');
        const mv = document.createElement('model-viewer');
        mv.setAttribute('src', shell.dataset.src ?? '');
        mv.setAttribute('alt', shell.dataset.alt ?? '3D model');
        if (shell.dataset.poster) mv.setAttribute('poster', shell.dataset.poster);
        mv.setAttribute('camera-controls', '');
        mv.setAttribute('touch-action', 'pan-y');
        mv.setAttribute('shadow-intensity', '0.8');
        mv.setAttribute('exposure', '1');
        mv.setAttribute('interaction-prompt', 'none');
        if (shell.dataset.rotate === 'true' && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          mv.setAttribute('auto-rotate', '');
        }
        mv.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;background:transparent;--poster-color:transparent;';
        shell.replaceChildren(mv);
        mv.focus();
      } catch {
        btn.disabled = false;
        btn.textContent = 'Could not load model — retry';
      }
    });
  });
</script>
