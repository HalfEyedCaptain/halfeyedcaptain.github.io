---
/**
 * Portfolio card. Thumbnails are cropped to a consistent ratio in grids
 * (art is shown uncropped on the project page). Carries data-* attributes used
 * by the portfolio filter/sort script.
 */
import { getImage } from 'astro:assets';
import ArtImage from './ArtImage.astro';
import Icon from './Icon.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import type { Project } from '@/lib/content';
import { formatYear, dateSortKey } from '@/lib/dates';
import { resolveImage } from '@/lib/images';
import { url } from '@/lib/site';

interface Props {
  project: Project;
  aspect?: string;
  sizes?: string;
  /** Show a fullscreen-preview button (portfolio page). */
  expandable?: boolean;
  headingLevel?: 'h2' | 'h3';
  priority?: boolean;
}

const { project, aspect = '4 / 5', sizes = '(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw', expandable = false, headingLevel: H = 'h3', priority = false } =
  Astro.props;
const d = project.data;
const thumb = d.thumbnail ?? d.hero ?? d.renders[0];
const href = url(`/work/${project.slug}`);
const year = formatYear(d.completed);

let fullSrc: string | undefined;
const resolved = resolveImage(thumb?.src);
if (expandable && resolved?.kind === 'local') {
  fullSrc = (await getImage({ src: resolved.meta, width: Math.min(resolved.meta.width, 2400), format: 'webp', quality: 85 })).src;
} else if (expandable && resolved?.kind === 'remote') {
  fullSrc = resolved.src;
}
---

<article
  class="project-card group relative"
  data-project
  data-category={d.category ?? ''}
  data-classification={d.classification}
  data-featured={String(d.featured)}
  data-date={String(dateSortKey(d.completed))}
  data-title={d.title.toLowerCase()}
  data-order={String(d.order)}
>
  <a href={href} class="block focus-visible:outline-offset-4" aria-describedby={`meta-${project.id}`}>
    <div class="relative overflow-hidden rounded-md border border-line">
      <ArtImage
        src={thumb?.src}
        alt={thumb?.alt || d.title}
        aspect={aspect}
        widths={[400, 640, 960, 1280]}
        sizes={sizes}
        priority={priority}
        imgClass="transition-transform duration-700 ease-(--ease-out-quart) group-hover:scale-[1.03]"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-scrim/50 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
      <div class="absolute top-3 left-3 flex flex-wrap gap-2">
        <PlaceholderBadge show={d.placeholder} />
        {d.status === 'draft' && <span class="placeholder-badge !bg-fg !text-surface">Draft</span>}
      </div>
    </div>
    <div class="mt-4 flex items-start justify-between gap-4">
      <H class="text-title-lg font-semibold text-fg transition-colors group-hover:text-primary">{d.title}</H>
      <Icon name="arrow-up-right" size={18} class="mt-1 shrink-0 text-fg-subtle transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary" />
    </div>
    <p id={`meta-${project.id}`} class="label mt-2 flex flex-wrap gap-x-3 gap-y-1">
      {project.categoryInfo && <span>{project.categoryInfo.label}</span>}
      <span>{d.classification === 'professional' ? 'Professional' : 'Personal'}</span>
      {year && <span>{year}</span>}
    </p>
  </a>
  {
    expandable && fullSrc && (
      <button
        type="button"
        class="absolute top-3 right-3 inline-flex h-10 w-10 items-center justify-center rounded-full border border-line bg-surface-lowest/90 text-fg opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 focus-visible:opacity-100"
        data-lightbox-item
        data-group="portfolio"
        data-src={fullSrc}
        data-alt={thumb?.alt || d.title}
        data-caption={d.title}
        aria-label={`View ${d.title} fullscreen`}
      >
        <Icon name="expand" size={18} />
      </button>
    )
  }
</article>
