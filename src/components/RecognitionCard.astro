---
import Icon from './Icon.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import { RECOGNITION_LABELS, type Recognition } from '@/lib/content';
import { formatMonthYear } from '@/lib/dates';

interface Props {
  item: Recognition;
}
const { item } = Astro.props;
const d = item.data;
const Tag = d.url ? 'a' : 'div';
---

<Tag
  href={d.url}
  target={d.url ? '_blank' : undefined}
  rel={d.url ? 'noopener' : undefined}
  class:list={['group flex h-full flex-col border-t border-ink-700 pt-5', d.url && 'transition-colors hover:border-copper-500']}
  data-reveal
>
  <div class="flex items-center justify-between gap-3">
    <p class="label text-copper-400">{RECOGNITION_LABELS[d.type]}</p>
    <p class="label">{formatMonthYear(d.date)}</p>
  </div>
  <h3 class="display mt-4 text-xl leading-snug group-hover:text-copper-300">{d.title}</h3>
  {d.issuer && <p class="mt-2 text-sm text-bone-300">{d.issuer}</p>}
  {d.description && <p class="mt-3 text-sm text-bone-500">{d.description}</p>}
  <div class="mt-auto flex items-center justify-between gap-3 pt-5">
    <PlaceholderBadge show={d.placeholder} />
    {d.url && <Icon name="arrow-up-right" size={16} class="ml-auto text-bone-500 group-hover:text-copper-400" />}
  </div>
</Tag>
