---
/**
 * Page-level SEO: title, description, canonical, Open Graph, Twitter card,
 * robots, and JSON-LD structured data.
 */
import { getImage } from 'astro:assets';
import { getProfile, getSettings } from '@/lib/content';
import { localImage } from '@/lib/images';
import { absoluteUrl } from '@/lib/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
}

const { title, description, image, imageAlt, type = 'website', noindex = false, jsonLd } = Astro.props;
const [settings, profile] = await Promise.all([getSettings(), getProfile()]);

const fullTitle = title ? `${title} — ${profile.name}` : settings.siteTitle;
const desc = (description ?? settings.description).replace(/\s+/g, ' ').slice(0, 300);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

let ogImageUrl: string | undefined;
const ogSrc = image ?? settings.ogImage?.src;
const meta = localImage(ogSrc);
if (meta) {
  const og = await getImage({ src: meta, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
  ogImageUrl = absoluteUrl(og.src, Astro.site);
} else if (ogSrc && /^https?:/i.test(ogSrc)) {
  ogImageUrl = ogSrc;
}

const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const keywords = settings.keywords.join(', ');
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content={profile.name} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.siteTitle} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={settings.locale.replace('-', '_')} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && <meta property="og:image:width" content="1200" />}
{ogImageUrl && <meta property="og:image:height" content="630" />}
{ogImageUrl && <meta property="og:image:alt" content={imageAlt ?? fullTitle} />}

<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

{ld.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
