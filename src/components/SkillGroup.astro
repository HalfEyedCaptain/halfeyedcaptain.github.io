---
/** A named group of skills. Deliberately no percentage bars or ratings. */
import PlaceholderBadge from './PlaceholderBadge.astro';

interface Props {
  title: string;
  items: string[];
  placeholder?: boolean;
  class?: string;
}
const { title, items, placeholder = false, class: className } = Astro.props;
---

<div class:list={['border-t border-line pt-5', className]}>
  <div class="mb-4 flex items-center gap-3">
    <h3 class="label text-fg-muted">{title}</h3>
    <PlaceholderBadge show={placeholder} />
  </div>
  <ul class="flex flex-wrap gap-2">
    {
      items.map((s) => (
        <li class="border border-line px-3 py-1.5 text-sm text-fg">{s}</li>
      ))
    }
  </ul>
</div>
