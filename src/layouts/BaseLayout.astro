---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getSettings } from '@/lib/content';
import { url } from '@/lib/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
  /** Extra class on <main>. */
  mainClass?: string;
}

const { mainClass, ...seo } = Astro.props;
const settings = await getSettings();
const referencePage = ['/', '/about', '/resume', '/work'].some((p) => p === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.replace(/\/$/, '') === p || Astro.url.pathname.includes('/work/')); 
---

<!doctype html>
<html lang={settings.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f9" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <SEO {...seo} />
    <slot name="head" />
  </head>
  <body class:list={[referencePage && 'reference-page']}>
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-primary-bright px-4 py-3 font-mono text-label-md text-on-primary uppercase focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <div class:list={[referencePage && 'reference-shell']}>
    <Header />
    <main id="main" tabindex="-1" class:list={['outline-none pt-(--header-h)', mainClass]}>
      <slot />
    </main>
    </div>
    {!referencePage && <Footer />}

    <script>
      // Gentle reveal-on-scroll. Content is always visible without JS or with reduced motion.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add('is-visible'));
      }
      window.addEventListener('beforeprint', () => targets.forEach((t) => t.classList.add('is-visible')));
    </script>
  </body>
</html>
