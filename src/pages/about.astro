---
/**
 * About (design: about_me_intro).
 * Portrait card (left) · Introduction + Get in touch disclosures (right),
 * followed by the long-form about sections.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArtImage from '@/components/ArtImage.astro';
import Icon, { type IconName } from '@/components/Icon.astro';
import DisclosureHeading from '@/components/DisclosureHeading.astro';
import Paragraphs from '@/components/Paragraphs.astro';
import PlaceholderBadge from '@/components/PlaceholderBadge.astro';
import { getAbout, getProfile, getSkills, getExperience, getSelectedProjects, getResumePdfPath } from '@/lib/content';
import { personLd } from '@/lib/structured-data';
import { url } from '@/lib/site';

const [about, profile, skills, jobs, projects, pdf] = await Promise.all([
  getAbout(),
  getProfile(),
  getSkills(),
  getExperience(),
  getSelectedProjects(),
  getResumePdfPath(),
]);
const portraitIsPlaceholder = Boolean(about.portrait?.src.includes('placeholder'));

// Introduction card
const discipline = profile.title.replace(/^./, (c) => c.toUpperCase());
const introTitle = profile.location ? `A ${discipline} based in ${profile.location}` : `A ${discipline}`;
const latest = projects[0];
const latestThumb = latest ? (latest.data.thumbnail ?? latest.data.hero ?? latest.data.renders[0]) : undefined;

// Get in touch — only links that actually exist in the profile.
const NAMES: Record<string, string> = { artstation: 'ArtStation', linkedin: 'LinkedIn', github: 'GitHub', instagram: 'Instagram', x: 'X', youtube: 'YouTube', vimeo: 'Vimeo', sketchfab: 'Sketchfab', behance: 'Behance', website: 'Website' };
type Contact = { href: string; label: string; icon: IconName; external: boolean; download?: boolean };
const contacts: Contact[] = [
  ...(profile.email ? [{ href: `mailto:${profile.email}`, label: 'Email', icon: 'mail' as IconName, external: false }] : []),
  ...profile.socials.map((s) => ({ href: s.url, label: s.label ?? NAMES[s.platform] ?? 'Link', icon: s.platform as IconName, external: true })),
  { href: pdf ? url(pdf) : url('/resume'), label: pdf ? 'Download CV' : 'Résumé', icon: 'download', external: false, download: Boolean(pdf) },
];
// Card treatments cycle through the mockup's three styles: inverse · electric blue · white.
const CARD = [
  'bg-inverse text-on-inverse border-fg hover:border-primary-bright',
  'bg-primary-bright text-on-primary border-primary-bright hover:bg-primary hover:border-primary',
  'bg-surface-lowest text-fg border-fg hover:border-primary',
];
const cols = ['', 'sm:grid-cols-1', 'sm:grid-cols-2', 'sm:grid-cols-3'][Math.min(contacts.length, 3)];
---

<BaseLayout
  title="About"
  description={`About ${profile.name} — ${profile.title}. Biography, ZBrush specialisation, workflow and toolkit.`}
  image={about.portrait?.src}
  type="profile"
  jsonLd={personLd(profile, Astro.site, { jobs, skills: skills.groups.filter((g) => !g.placeholder).flatMap((g) => g.items) })}
>
  <section class="container-page grid items-stretch gap-gutter-lg lg:grid-cols-12 reference-about">
    <!-- Portrait card -->
    <div class="relative isolate flex min-h-[560px] flex-col justify-between overflow-hidden rounded-lg border border-fg bg-inverse lg:col-span-5">
      <div class="absolute inset-0 -z-10">
        {
          about.portrait && (
            <ArtImage
              src={about.portrait.src}
              alt={about.portrait.alt || `Portrait of ${profile.name}`}
              class="h-full w-full"
              imgClass="grayscale"
              aspect="auto"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              priority
            />
          )
        }
        <div class="absolute inset-0 bg-linear-to-b from-scrim/65 via-transparent to-scrim/85" aria-hidden="true"></div>
      </div>

      <div class="flex flex-col gap-gutter-sm p-gutter-xl">
        <p class="font-mono text-label-lg text-on-inverse">Hello,</p>
        <h1 class="display text-display-md text-on-scrim">My name is {profile.name}</h1>
        <PlaceholderBadge show={portraitIsPlaceholder} text="Placeholder photo" class="self-start" />
      </div>

      {
        profile.tagline && (
          <div class="flex justify-end p-gutter-xl">
            <p class="max-w-sm text-right text-body-md text-on-inverse">{profile.tagline}</p>
          </div>
        )
      }
    </div>

    <!-- Introduction + contact -->
    <div class="flex flex-col justify-between gap-gutter-xl lg:col-span-7">
      <section aria-labelledby="intro-heading">
        <DisclosureHeading id="intro-heading" title="Introduction" controls="intro-panel" class="mb-gutter-md" />
        <div id="intro-panel" class="grid items-center gap-gutter-lg rounded-md border border-fg bg-surface-lowest p-gutter-xl md:grid-cols-12">
          <div class:list={['flex flex-col gap-gutter-md', latestThumb ? 'md:col-span-8' : 'md:col-span-12']}>
            <h3 class="text-title-lg font-semibold text-fg">{introTitle}</h3>
            <Paragraphs text={profile.bio} class="flex flex-col gap-gutter-sm text-body-md text-fg-muted" />
          </div>
          {
            latest && latestThumb && (
              <a href={url(`/work/${latest.slug}`)} class="group flex flex-col gap-gutter-sm md:col-span-4 md:items-center">
                <div class="w-36 overflow-hidden rounded-md border border-fg">
                  <ArtImage src={latestThumb.src} alt={latestThumb.alt || latest.data.title} aspect="1 / 1" widths={[160, 320]} sizes="144px" />
                </div>
                
              </a>
            )
          }
        </div>
      </section>

      <hr class="border-line" />

      <section aria-labelledby="contact-heading">
        <DisclosureHeading id="contact-heading" title="Get In Touch" controls="contact-panel" class="mb-gutter-md" />
        <ul id="contact-panel" class:list={['grid gap-gutter-md', cols]}>
          {
            contacts.map((c, i) => (
              <li>
                <a
                  href={c.href}
                  class:list={['flex h-full min-h-40 flex-col justify-between gap-gutter-xl rounded-md border p-gutter-lg transition-colors duration-120 ease-(--ease-standard)', CARD[i % 3]]}
                  rel={c.external ? 'me noopener' : undefined}
                  target={c.external ? '_blank' : undefined}
                  download={c.download ? '' : undefined}
                >
                  <span class="flex items-start justify-between">
                    <Icon name={c.icon} size={28} />
                    <Icon name="arrow-up-right" size={20} />
                  </span>
                  <span class="border-t border-current/25 pt-gutter-sm font-mono text-label-md uppercase">{c.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>

</BaseLayout>
