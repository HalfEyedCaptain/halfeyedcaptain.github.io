---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArtImage from '@/components/ArtImage.astro';
import Paragraphs from '@/components/Paragraphs.astro';
import PlaceholderBadge from '@/components/PlaceholderBadge.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SkillGroup from '@/components/SkillGroup.astro';
import Topology from '@/components/Topology.astro';
import { getAbout, getProfile, getSkills, getExperience } from '@/lib/content';
import { personLd } from '@/lib/structured-data';
import { url } from '@/lib/site';

const [about, profile, skills, jobs] = await Promise.all([getAbout(), getProfile(), getSkills(), getExperience()]);
const software = skills.groups.filter((g) => g.kind === 'software');
const expertise = skills.groups.filter((g) => g.kind !== 'software');
const portraitIsPlaceholder = Boolean(about.portrait?.src.includes('placeholder'));
---

<BaseLayout
  title="About"
  description={`About ${profile.name} — ${profile.title}. Biography, ZBrush specialisation, workflow and toolkit.`}
  image={about.portrait?.src}
  type="profile"
  jsonLd={personLd(profile, Astro.site, { jobs, skills: skills.groups.filter((g) => !g.placeholder).flatMap((g) => g.items) })}
>
  <section class="container-page grid gap-12 pt-12 md:pt-20 lg:grid-cols-[5fr_7fr] lg:gap-20">
    {
      about.portrait && (
        <div class="relative lg:sticky lg:top-28 lg:self-start">
          <ArtImage src={about.portrait.src} alt={about.portrait.alt || `Portrait of ${profile.name}`} aspect="4 / 5" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 38vw, 100vw" priority />
          <PlaceholderBadge show={portraitIsPlaceholder} text="Placeholder photo" class="absolute top-3 left-3" />
        </div>
      )
    }
    <div class:list={[!about.portrait && 'lg:col-span-2 max-w-4xl']}>
      <p class="label mb-4 flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-copper-500" aria-hidden="true"></span>About
      </p>
      <h1 class="display text-display-lg">{about.intro ?? profile.name}</h1>
      <p class="mt-6 font-mono text-sm tracking-[0.16em] text-copper-400 uppercase">{profile.title}</p>
      <Paragraphs text={profile.bio} class="prose-art mt-10" />

      {
        about.philosophy && (
          <blockquote class="mt-14 border-l border-copper-500 pl-6">
            <p class="label mb-3">Artistic philosophy</p>
            <Paragraphs text={about.philosophy} class="display text-xl leading-relaxed text-bone-100 md:text-2xl" />
          </blockquote>
        )
      }

      {
        about.highlights.length > 0 && (
          <div class="mt-14">
            <h2 class="label mb-4">Career highlights</h2>
            <ul class="prose-art">
              {about.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mt-12 flex flex-wrap gap-3">
        <a href={url('/resume')} class="btn btn-primary">View résumé</a>
        <a href={url('/portfolio')} class="btn btn-outline">View portfolio</a>
      </div>
    </div>
  </section>

  {
    about.specialization && (
      <section class="relative mt-28 overflow-hidden border-y border-ink-700 bg-ink-900 py-20 md:mt-40 md:py-28" aria-labelledby="zbrush">
        <Topology class="absolute inset-0 h-full w-full text-copper-500" opacity={0.12} />
        <div class="container-page relative grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-20">
          <SectionHeading id="zbrush" label="Specialisation" title="ZBrush & digital sculpting" />
          <Paragraphs text={about.specialization} class="prose-art !max-w-3xl text-lg" />
        </div>
      </section>
    )
  }

  {
    about.workflow.length > 0 && (
      <section class="container-page mt-28 md:mt-40" aria-labelledby="workflow">
        <SectionHeading id="workflow" label="Process" title="Character production workflow" />
        <ol class="mt-12 grid border-t border-l border-ink-700 sm:grid-cols-2 lg:grid-cols-3">
          {about.workflow.map((step, i) => (
            <li class="border-r border-b border-ink-700 p-6 md:p-8" data-reveal>
              <span class="label text-copper-400">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display mt-4 text-2xl">{step.title}</h3>
              {step.description && <p class="mt-3 text-sm text-bone-300">{step.description}</p>}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    (expertise.length > 0 || software.length > 0) && (
      <section class="container-page mt-28 md:mt-40" aria-labelledby="toolkit">
        <SectionHeading id="toolkit" label="Toolkit" title="Technical expertise & software" />
        <div class="mt-12 grid gap-10 md:grid-cols-2">
          {[...software, ...expertise].map((g) => (
            <SkillGroup title={g.title} items={g.items} placeholder={g.placeholder} />
          ))}
        </div>
      </section>
    )
  }

  {
    about.interests.length > 0 && (
      <section class="container-page mt-28 md:mt-40" aria-labelledby="interests">
        <SectionHeading id="interests" label="Beyond the viewport" title="Professional interests" />
        <ul class="mt-10 flex flex-wrap gap-2">
          {about.interests.map((i) => (
            <li class="border border-ink-700 px-4 py-2 text-bone-100">{i}</li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
