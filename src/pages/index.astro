---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import { getHome, getProfile, getSelectedProjects, getExperience, getSkills } from '@/lib/content';
import { personLd } from '@/lib/structured-data';
const [home, profile, projects, jobs, skills] = await Promise.all([getHome(), getProfile(), getSelectedProjects(), getExperience(), getSkills()]);
const { hero } = home;
const isPlaceholderHero = Boolean(hero.image?.src.includes('placeholder'));
const skillNames = skills.groups.filter((g) => !g.placeholder).flatMap((g) => g.items);
const chips = [...new Set(skillNames.length ? skillNames : projects.flatMap((p) => p.data.software))].slice(0, 6);
---

<BaseLayout
  description={profile.tagline}
  image={hero.image?.src}
  imageAlt={hero.image?.alt}
  type="profile"
  jsonLd={personLd(profile, Astro.site, { jobs, skills: skillNames })}
>
  <Hero
    projects={projects}
    chips={chips}
    image={hero.image}
    eyebrow={hero.eyebrow}
    heading={hero.heading ?? profile.name}
    subheading={hero.subheading ?? profile.title}
    intro={hero.intro ?? profile.tagline}
    focus={hero.focus}
    isPlaceholderImage={isPlaceholderHero}
  />

</BaseLayout>
